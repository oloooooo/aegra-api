# Copy to .env in the project root and fill in real values. .env is gitignored
# and auto-loaded by src/aegra_api/settings.py (os.environ wins over this file).

# --- PostgreSQL (e2e / server needs a real PG) ---
# Either set DATABASE_URL ... (takes precedence)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aegra
# ...or the individual vars (used when DATABASE_URL is unset):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aegra

# --- LLM: OpenAI-compatible API ---
# api-key / base_url are read directly from the environment by langchain-openai
# (ChatOpenAI); settings.py loads .env into os.environ, so both server config
# and graphs see them.
OPENAI_API_KEY=sk-...
# Only needed for an OpenAI-compatible endpoint (DeepSeek / Moonshot / vLLM / ...);
# leave unset for api.openai.com.
OPENAI_BASE_URL=https://api.openai.com/v1

# model name is NOT read from env by langchain-openai — your graph module must
# pass it explicitly, e.g. in graphs/researcher.py:
#   import os
#   from deepagents import create_deep_agent
#   graph = create_deep_agent(model=f"openai:{os.environ['OPENAI_MODEL']}", ...)
OPENAI_MODEL=gpt-5.5

# --- Server ---
HOST=0.0.0.0
PORT=2026
AUTH_TYPE=noop
AEGRA_CONFIG=aegra.json

# Windows only: uvicorn needs the selector event loop for psycopg/asyncpg.
# Run with: uvicorn aegra_api.main:app --port 2026 --loop "asyncio:SelectorEventLoop"
