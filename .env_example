# Copy to .env in the project root and fill in real values. .env is gitignored
# and auto-loaded by src/aegra_api/settings.py (os.environ wins over this file).

# --- PostgreSQL (e2e / server needs a real PG) ---
# Either set DATABASE_URL ... (takes precedence)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aegra
# ...or the individual vars (used when DATABASE_URL is unset):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aegra

# --- LLM: OpenAI-compatible API ---
# api-key / base_url are read directly from the environment by langchain-openai
# (ChatOpenAI); settings.py loads .env into os.environ, so both server config
# and graphs see them.
OPENAI_API_KEY=sk-...
# Only needed for an OpenAI-compatible endpoint (DeepSeek / Moonshot / vLLM / ...);
# leave unset for api.openai.com.
OPENAI_BASE_URL=https://api.openai.com/v1

# model name is NOT read from env by langchain-openai — your graph module must
# pass it explicitly, e.g. in graphs/researcher.py:
#   import os
#   from deepagents import create_deep_agent
#   graph = create_deep_agent(model=f"openai:{os.environ['OPENAI_MODEL']}", ...)
OPENAI_MODEL=gpt-5.5

# --- Server ---
HOST=0.0.0.0
PORT=2026
AUTH_TYPE=noop
AEGRA_CONFIG=aegra.json

# --- Auth (custom/routers.py 注册/登录 + custom/services.py 签验 token) ---
# JWT 签名密钥（HS256），必须设置，否则启动即 KeyError。生产用长随机串:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
# 密码 pepper：bcrypt 哈希前拼接的全局密文，必须设置。改了这个值，
# 之前注册的用户全部无法登录（哈希不再匹配），需重新注册/重置密码。
PASSWORD_PEPPER=change-me-too
# access token 有效期（秒），默认 3600（1 小时）。
ACCESS_TOKEN_TTL=3600

# --- Logging ---
# Level for both console and file. Local/dev console output is coloured;
# any other ENV_MODE (e.g. PRODUCTION) prints JSON. Log files are always JSON.
LOG_LEVEL=INFO
# "verbose" adds request_id to the access-log lines; anything else omits it.
LOG_VERBOSITY=verbose
# Comma-separated path prefixes to skip in access logs (errors are always logged).
# LOG_EXCLUDE_PATHS=/health,/ready
# File logging: rotated at LOG_FILE_MAX_MB, rotated files older than
# LOG_FILE_RETENTION_DAYS are deleted on the next rotation. Relative paths are
# relative to the process CWD. Set LOG_FILE= (empty) for stdout only.
LOG_FILE=logs/aegra.log
LOG_FILE_MAX_MB=10
LOG_FILE_RETENTION_DAYS=7

# Windows only: uvicorn needs the selector event loop for psycopg/asyncpg.
# Run with: uvicorn aegra_api.main:app --port 2026 --loop "asyncio:SelectorEventLoop"

# --- 业务上限 ---
# 一个账号最多同时拥有几个会话（主管线程，默认 200）；子线程计数到它所属的主管上。
# 超额时 POST /threads 返回 403。见 docs/adr/0012。
MAX_THREADS_PER_USER=200
