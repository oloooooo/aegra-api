# Copy to .env in the project root and fill in real values. .env is gitignored
# and auto-loaded by src/aegra_api/settings.py (real env vars win over this file).
#
# 这个文件只放两类东西（逐键说明见 docs/configuration.md §3）：
#   A. aegra 原生的运行参数 —— 由 src/aegra_api/settings.py 读，升级 aegra 时跟上游走
#   B. 密钥 —— 凭据只放这里，不进 git、不进 config.yaml
#   C. 第三方 SDK —— langchain-openai / 图代码
#
# 本项目新增的**非密钥**参数（配额、文件上限、S3 地址、OKF、发件箱）在仓库根
# 的 config.yaml，不在这个文件里。A 段这里只列常用的，Redis/worker、cron、
# 保留策略、OpenTelemetry、Prometheus 按 docs/configuration.md §3.1 加，默认值都能跑。

# =============================================================================
# A. aegra 原生（src/aegra_api/settings.py）
# =============================================================================

# --- PostgreSQL (e2e / server needs a real PG) ---
# Either set DATABASE_URL ... (takes precedence)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aegra
# ...or the individual vars (used when DATABASE_URL is unset):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aegra

# --- Server ---
HOST=0.0.0.0
PORT=2026
AUTH_TYPE=noop
AEGRA_CONFIG=aegra.json

# --- Logging ---
# Level for both console and file. Local/dev console output is coloured;
# any other ENV_MODE (e.g. PRODUCTION) prints JSON. Log files are always JSON.
LOG_LEVEL=INFO
# "verbose" adds request_id to the access-log lines; anything else omits it.
LOG_VERBOSITY=verbose
# Comma-separated path prefixes to skip in access logs (errors are always logged).
# LOG_EXCLUDE_PATHS=/health,/ready
# File logging: rotated at LOG_FILE_MAX_MB, rotated files older than
# LOG_FILE_RETENTION_DAYS are deleted on the next rotation. Relative paths are
# relative to the process CWD. Set LOG_FILE= (empty) for stdout only.
LOG_FILE=logs/aegra.log
LOG_FILE_MAX_MB=10
LOG_FILE_RETENTION_DAYS=7

# Windows only: uvicorn needs the selector event loop for psycopg/asyncpg.
# Run with: uvicorn aegra_api.main:app --port 2026 --loop "asyncio:SelectorEventLoop"

# =============================================================================
# B. 密钥（只放这里；config.yaml 里一律不写）
# =============================================================================

# --- 鉴权（custom/services.py、custom/custom_auth.py）---
# JWT 签名密钥（HS256），必须设置，否则启动即 KeyError。生产用长随机串:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
# 密码 pepper：哈希前拼接的全局密文，必须设置。改了这个值，
# 之前注册的用户全部无法登录（哈希不再匹配），需重新注册/重置密码。
PASSWORD_PEPPER=change-me-too

# --- 子 agent 读会话文件的凭证（graphs/session_scope.py）---
# 签/验 session_scope 的 HMAC 密钥，生产必须换成随机串；客户端看不到它。
SESSION_SCOPE_SECRET=change-me

# --- 对象存储凭证（custom/blobs.py；地址/桶名在 config.yaml 的 s3.*）---
# SeaweedFS 未配 IAM 时填任意值即可。
S3_ACCESS_KEY=dev
S3_SECRET_KEY=dev

# =============================================================================
# C. 第三方 SDK 与模型（langchain-openai / graphs/llms.py）
# =============================================================================
# api-key / base_url 由 langchain-openai 从环境读（settings.py 把 .env 灌进
# os.environ），graphs/llms.py 也显式传了一遍。
OPENAI_API_KEY=sk-...
# Only needed for an OpenAI-compatible endpoint (DeepSeek / Moonshot / vLLM / ...);
# leave unset for api.openai.com.
OPENAI_BASE_URL=https://api.openai.com/v1

# model name has no SDK convention — graphs/llms.py reads it explicitly:
#   ChatOpenAI(model=os.environ.get("OPENAI_MODEL", ""), ...)
OPENAI_MODEL=gpt-5.5
